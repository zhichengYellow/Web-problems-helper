{
  "meta": {
    "category": "dynamic_programming",
    "title": "动态规划高频题（C/C++）",
    "version": "1.0.0",
    "updated_at": "2025-09-23",
    "language": "zh-CN"
  },
  "questions": [
    {
      "id": "dp_001",
      "title": "斐波那契数（迭代与滚动数组）",
      "description": "计算第 n 个斐波那契数，可取模。",
      "difficulty": "easy",
      "tags": ["dp", "math"],
      "io": { "input_format": "整数 n, 0<=n<=1e7, 可选 mod", "output_format": "F(n)" },
      "examples": [{ "input": "n=10", "output": "55" }],
      "constraints": "O(n) 或 O(1) 空间；大 n 需循环滚动。",
      "solution_outline": "滚动保存前两项；如需矩阵快速幂则 O(log n)。"
    },
    {
      "id": "dp_002",
      "title": "爬楼梯（每次 1/2 阶）",
      "description": "共有多少种不同走法。",
      "difficulty": "easy",
      "tags": ["dp"],
      "io": { "input_format": "n 阶", "output_format": "方案数" },
      "examples": [{ "input": "n=3", "output": "3" }],
      "constraints": "dp[i]=dp[i-1]+dp[i-2]；初值 dp[0]=1, dp[1]=1。",
      "solution_outline": "滚动数组或常量空间迭代。"
    },
    {
      "id": "dp_003",
      "title": "最长递增子序列（LIS）",
      "description": "返回 LIS 长度。",
      "difficulty": "medium",
      "tags": ["dp", "binary-search"],
      "io": { "input_format": "数组 nums", "output_format": "int" },
      "examples": [{ "input": "[10,9,2,5,3,7,101,18]", "output": "4" }],
      "constraints": "O(n log n) 使用贪心+二分；O(n^2) 为基础 DP。",
      "solution_outline": "维护 tails 数组，二分定位；或 dp[i]=max(dp[j])+1。"
    },
    {
      "id": "dp_004",
      "title": "最长公共子序列（LCS）",
      "description": "返回两个字符串的 LCS 长度。",
      "difficulty": "medium",
      "tags": ["dp", "string"],
      "io": { "input_format": "字符串 a,b", "output_format": "int" },
      "examples": [{ "input": "a=\"abcde\", b=\"ace\"", "output": "3" }],
      "constraints": "O(|a||b)；可滚动压缩一维。",
      "solution_outline": "dp[i][j]=(a[i-1]==b[j-1])?dp[i-1][j-1]+1:max(dp[i-1][j],dp[i][j-1])。"
    },
    {
      "id": "dp_005",
      "title": "编辑距离",
      "description": "将 word1 转换为 word2 的最少操作数（增删改）。",
      "difficulty": "medium",
      "tags": ["dp", "string"],
      "io": { "input_format": "word1, word2", "output_format": "int" },
      "examples": [{ "input": "word1=horse, word2=ros", "output": "3" }],
      "constraints": "O(mn)；空间可压缩到 O(min(m,n))。",
      "solution_outline": "dp[i][j] 来自增删改三选一；相同字符继承 dp[i-1][j-1]。"
    },
    {
      "id": "dp_006",
      "title": "0/1 背包",
      "description": "给定价值与重量，容量 W，最大总价值。",
      "difficulty": "medium",
      "tags": ["dp", "knapsack"],
      "io": { "input_format": "w[], v[], W", "output_format": "int" },
      "examples": [{ "input": "w=[2,3,4], v=[4,5,6], W=5", "output": "9" }],
      "constraints": "O(nW)；一维倒序遍历容量。",
      "solution_outline": "dp[cap]=max(dp[cap], dp[cap-w[i]]+v[i])，cap 从 W 到 w[i] 倒序。"
    },
    {
      "id": "dp_007",
      "title": "零钱兑换（最少硬币）",
      "description": "给定面额集与金额，返回最少硬币数，不可达则 -1。",
      "difficulty": "medium",
      "tags": ["dp"],
      "io": { "input_format": "coins[], amount", "output_format": "int" },
      "examples": [{ "input": "coins=[1,2,5], amount=11", "output": "3" }],
      "constraints": "O(n*amount)；初始化为 INF。",
      "solution_outline": "dp[x]=min(dp[x], dp[x-coin]+1)，coin 正序遍历。"
    },
    {
      "id": "dp_008",
      "title": "打家劫舍",
      "description": "相邻房屋不可同时偷，最大收益。",
      "difficulty": "easy",
      "tags": ["dp"],
      "io": { "input_format": "nums[]", "output_format": "int" },
      "examples": [{ "input": "[1,2,3,1]", "output": "4" }],
      "constraints": "O(n)；滚动两个状态。",
      "solution_outline": "cur=max(prev2+nums[i], prev1)，滚动更新 prev1/prev2。"
    },
    {
      "id": "dp_009",
      "title": "最大子数组和（Kadane）",
      "description": "返回连续子数组的最大和。",
      "difficulty": "easy",
      "tags": ["dp"],
      "io": { "input_format": "nums[]", "output_format": "int" },
      "examples": [{ "input": "[-2,1,-3,4,-1,2,1,-5,4]", "output": "6" }],
      "constraints": "O(n)；空间 O(1)。",
      "solution_outline": "dp[i]=max(nums[i], dp[i-1]+nums[i])；记录全局最大值。"
    },
    {
      "id": "dp_010",
      "title": "不同路径（含障碍）",
      "description": "机器人从左上到右下，障碍为 1。",
      "difficulty": "medium",
      "tags": ["dp", "grid"],
      "io": { "input_format": "m*n 网格", "output_format": "路径数" },
      "examples": [{ "input": "[[0,0,0],[0,1,0],[0,0,0]]", "output": "2" }],
      "constraints": "O(mn)；首行首列需单独处理。",
      "solution_outline": "障碍位置 dp=0；否则 dp[i][j]=dp[i-1][j]+dp[i][j-1]。"
    },
    {
      "id": "dp_011",
      "title": "最长回文子串",
      "description": "返回字符串的最长回文子串。",
      "difficulty": "medium",
      "tags": ["dp", "string"],
      "io": { "input_format": "字符串 s", "output_format": "子串" },
      "examples": [{ "input": "babad", "output": "bab 或 aba" }],
      "constraints": "DP O(n^2)；中心扩展 O(n^2)；Manacher O(n)。",
      "solution_outline": "中心扩展：每个中心双向扩展；DP：f[i][j] 依赖 f[i+1][j-1] 与 s[i]==s[j]。"
    },
    {
      "id": "dp_012",
      "title": "划分等和子集",
      "description": "判断数组能否划分为和相等的两部分。",
      "difficulty": "medium",
      "tags": ["dp", "subset-sum"],
      "io": { "input_format": "nums[]", "output_format": "bool" },
      "examples": [{ "input": "[1,5,11,5]", "output": "true" }],
      "constraints": "目标为 sum/2 的子集和；一维倒序 0/1 背包。",
      "solution_outline": "dp[cap]|=dp[cap-num]；倒序遍历保护状态。"
    }
  ]
}