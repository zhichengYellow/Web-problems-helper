{
  "manifest_version": 3,
  "name": "Web 题目助手",
  "version": "1.2.0",
  "description": "PTA平台自动化/半自动化答题插件，支持外部API和本地存档",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://pintia.cn/*",
    "https://*.pintia.cn/*",
    "wss://live.pintia.cn/*",
    "https://api.sh-api.com/*",
    "https://*.sh-api.com/*",
    "https://api.openedu.org/*",
    "https://community-api.education/*",
    "https://api.academic-free.org/*",
    "https://api.wolframalpha.com/*",
    "https://*.wolframalpha.com/*",
    "https://en.wikipedia.org/*",
    "https://*.wikipedia.org/*",
    "https://api.duckduckgo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web 题目助手"
  },
  "options_page": "config-ui.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pintia.cn/*",
        "https://*.pintia.cn/*",
    "wss://live.pintia.cn/*"
      ],
      "js": ["utils.js", "hunyuan-service.js", "api-service.js", "ai-service.js", "answer-database.js", "programming-problem-detector.js", "programming-answer-enhancer.js", "wph-codemirror-filler.js", "wph-ui-enhancer.js", "programming-problem-integration.js", "programming-integration-complete.js", "content.js"],
      "css": ["content.css", "programming-styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": [
      "c-cpp-algorithm-questions/**/*.json"
    ],
    "matches": ["<all_urls>"]
  }]
}